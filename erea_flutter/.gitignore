# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata
pubspec.lock

# Plateformes non utilisées (regénérables par `flutter create .`)
macos/
linux/
windows/

# iOS — le projet Xcode est versionné (bundle id, team, orientations,
# icônes) ; seuls les artefacts locaux sont ignorés.
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Pods/
ios/.symlinks/
ios/Podfile.lock
**/xcuserdata/
*.mobileprovision

# Android — idem : la config Gradle est versionnée, pas les artefacts
# ni les secrets de signature.
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
android/key.properties
*.jks
*.keystore

# IDE
.idea/
*.iml
.vscode/

# Caches Python des outils de synthèse
tools/__pycache__/
