<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de démarrage jusqu'à Android 11 : fond crème et logo, comme
     sur iPhone. À partir d'Android 12, c'est le système qui dessine le
     démarrage avec l'icône de l'app (values-v31/styles.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#FFF7E8" />
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
