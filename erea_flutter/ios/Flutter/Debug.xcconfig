#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// google_mobile_ads 9.1.0 importe <GoogleMobileAds/GoogleMobileAds_Beta.h>
// depuis ses en-têtes publics, or ce fichier vit dans PrivateHeaders/ du
// xcframework de Google — hors module map. Le diagnostic se lève dans la
// compilation qui CONSTRUIT le module, c'est-à-dire ici, dans Runner, au
// moment d'importer le plugin : le poser sur les seules cibles Pods (build
// 96-99) ne suffisait pas. Même réglage dans Release.xcconfig.
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
